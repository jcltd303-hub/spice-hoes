# Keep the filled copy in ignored .env.swarm; never commit credentials.
SPICE_SWARM_CONFIG=data/swarm.json
SPICE_DB=data/experiments.sqlite
SPICE_MEDIA_PROVIDER=go
SPICE_MEDIA_BIN=bin/spicemedia
SPICE_QNN_MODEL_DIR=
# llama.cpp on the S24; no hosted key required.
SPICE_TEXT_PROVIDER=local
MOA_BASE_URL=http://127.0.0.1:8083/v1
MOA_MODEL=spice-local
SPICE_LLM_MODEL=
SPICE_LLM_GPU_LAYERS=99
SPICE_LLM_CONTEXT=4096
# Updated Android companion: offline TTS, on-device speech recognition.
SPICE_VOICE_PROVIDER=android
SPICE_ANDROID_VOICE_URL=http://127.0.0.1:8082
SPICE_ANDROID_VOICE_TOKEN=
SPICE_ANDROID_VOICE_MAP='{}'
SPICE_VIDEO_PROVIDER=freegpu
SPICE_LIPSYNC_PROVIDER=freegpu
SPICE_FREEGPU_DIR=data/freegpu
# Read-only directory exposed through your own HTTPS host/tunnel.
SPICE_MEDIA_PUBLIC_DIR=data/public-media
SPICE_MEDIA_PUBLIC_BASE_URL=
INSTAGRAM_ACCESS_TOKEN=
STRIPE_WEBHOOK_SECRET=
