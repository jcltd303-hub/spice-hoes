PORT=3000
NODE_ENV=development
PYTHON_BIN=python3
SPICE_DB=data/experiments.sqlite
SPICE_PERSONAS=personas

# OpenAI-compatible MoA text reasoning / optional embeddings
MOA_BASE_URL=https://openrouter.ai/api/v1
MOA_API_KEY=
# Generic fallback model for non-MoA callers. MoA itself pins one model per role.
MOA_MODEL=openrouter/free
MOA_MODEL_REVENUE=nvidia/nemotron-3-super-120b-a12b:free
MOA_MODEL_CREATIVE=qwen/qwen3.8-27b:free
MOA_MODEL_GROWTH=inclusionai/ling-3.0-flash-vl:free
MOA_MODEL_RISK=google/gemma-4-31b-it:free
MOA_MODEL_AGGREGATOR=nvidia/nemotron-3-ultra-550b-a55b:free
MOA_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free
MOA_HTTP_RETRIES=3
MOA_HTTP_BACKOFF_SECONDS=1.0
MOA_REASONING_ENABLED=false
MOA_AGGREGATOR_MAX_TOKENS=1800
MOA_EMBEDDING_MODEL=

# Canonical production media lane; Local Dream may remain side-by-side for benchmarking
SPICE_MEDIA_PROVIDER=go
SPICE_MEDIA_BIN=bin/spicemedia

# Go-managed standalone QNN engine (kept on 18081 so Local Dream can remain on 8081)
SPICE_QNN_CORE_BIN=runtime/bin/spice-qnn-core
SPICE_QNN_MODEL_DIR=
SPICE_QNN_LIB_DIR=runtime/lib
SPICE_QNN_TYPE=sd15npu
SPICE_QNN_HOST=127.0.0.1
SPICE_QNN_PORT=18081
SPICE_QNN_LOG=data/spicemedia/qnn-core.log
SPICE_FACE_EMBED_MODEL=models/face/arcface_w600k_r50.bin
SPICE_FACE_DETECT_MODEL=models/face/scrfd_10g.bin

# Local Dream baseline retained for A/B benchmark
LOCAL_DREAM_URL=http://127.0.0.1:8081
LOCAL_DREAM_TOKEN=


# Social distribution (real publishers fail closed if tokens are absent)
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# Imported media-provider credentials.
# These adapters are credential-detectable but intentionally fail closed until
# their production API I/O is fully wired.
LUMA_API_KEY=
ELEVENLABS_API_KEY=
SYNCLABS_API_KEY=

SPICE_IDENTITY_GENERATOR=local-dream
SPICE_ONNXRUNTIME_LIB=
SPICE_INSWAPPER_MODEL=
SPICE_IDENTITY_THRESHOLD=0.82
SPICE_QUALITY_THRESHOLD=0.78
SPICE_IDENTITY_MAX_ATTEMPTS=48
SPICE_POSE_MAX_ATTEMPTS=4


# Remote/open-source video lane (Google Colab/Kaggle ComfyUI)
# Set SPICE_VIDEO_PROVIDER=comfyui to make MediaPipeline use the remote worker.
SPICE_VIDEO_PROVIDER=mock
COMFYUI_BASE_URL=
COMFYUI_WORKFLOW=config/comfyui/wan_i2v_api.json
COMFYUI_TIMEOUT_SECONDS=900
COMFYUI_POLL_SECONDS=2
# Optional only when your reverse proxy adds auth; native ComfyUI has no bearer auth.
COMFYUI_BEARER_TOKEN=


# Local speech generation
SPICE_VOICE_PROVIDER=piper
PIPER_BIN=piper
PIPER_MODEL=
PIPER_CONFIG=
PIPER_VOICE_MAP={}
PIPER_TIMEOUT_SECONDS=180

# Local lip sync; production default is MuseTalk.
SPICE_LIPSYNC_PROVIDER=musetalk
MUSETALK_DIR=vendor/MuseTalk
MUSETALK_PYTHON=python3
MUSETALK_MODEL_DIR=vendor/MuseTalk/models/musetalkV15
MUSETALK_FFMPEG_PATH=
MUSETALK_TIMEOUT_SECONDS=1800

# Wav2Lip public upstream is non-commercial; dev/research only.
ALLOW_NONCOMMERCIAL_WAV2LIP=false
WAV2LIP_DIR=vendor/Wav2Lip
WAV2LIP_CHECKPOINT=
WAV2LIP_PYTHON=python3

# Optional durable Supabase mirror/private artifact storage.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=spice-private

# Static UI deployments may target an externally hosted control-plane API.
VITE_API_BASE_URL=
