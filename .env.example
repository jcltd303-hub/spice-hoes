PORT=3000
NODE_ENV=development
PYTHON_BIN=python3
SPICE_DB=data/experiments.sqlite
SPICE_PERSONAS=personas

# Azure text reasoning / embeddings
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Local S24 image lane
LOCAL_DREAM_URL=http://127.0.0.1:7860
LOCAL_DREAM_TOKEN=


# Social distribution (real publishers fail closed if tokens are absent)
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# Imported media-provider credentials.
# These adapters are credential-detectable but intentionally fail closed until
# their production API I/O is fully wired.
LUMA_API_KEY=
ELEVENLABS_API_KEY=
SYNCLABS_API_KEY=
