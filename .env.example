PORT=3000
NODE_ENV=development
PYTHON_BIN=python3
SPICE_DB=data/experiments.sqlite
SPICE_PERSONAS=personas

# OpenAI-compatible MoA text reasoning / optional embeddings
MOA_BASE_URL=https://openrouter.ai/api/v1
MOA_API_KEY=
MOA_MODEL=openrouter/free
MOA_EMBEDDING_MODEL=

# Local S24 image lane
LOCAL_DREAM_URL=http://127.0.0.1:8081
LOCAL_DREAM_TOKEN=


# Social distribution (real publishers fail closed if tokens are absent)
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# Imported media-provider credentials.
# These adapters are credential-detectable but intentionally fail closed until
# their production API I/O is fully wired.
LUMA_API_KEY=
ELEVENLABS_API_KEY=
SYNCLABS_API_KEY=
